# Copy to .env and adjust.

# API token (empty = no auth). Strongly recommended when the port is reachable from the network.
PG_API_TOKEN=
# Host interface and port for the API
PG_BIND=0.0.0.0
PG_PORT=8000
# Host directory with datasets, jobs and results
PG_DATA_DIR=./data
# Seconds without heartbeat before a running stage is considered lost
PG_STAGE_LEASE_SEC=180

# --- build options ---
# GPU architectures to compile for (Turing 75, Ampere 80/86, Ada 89, Hopper 90)
CUDA_ARCHITECTURES=75;80;86;89
TORCH_CUDA_ARCH_LIST=7.5;8.0;8.6;8.9
# Pin the official COLMAP image (e.g. colmap/colmap:<tag>) for reproducible builds
COLMAP_IMAGE=colmap/colmap:latest
# Refractive COLMAP git ref (branch/tag/commit)
COLMAP_UW_REF=underwater
# OpenMVS branch (develop = upstream docker default, master = last release)
OPENMVS_BRANCH=develop
# tiny-cuda-nn (part of the WaterSplatting install recipe); 0 to skip and save build time
INSTALL_TCNN=1

# Host directory mounted into the containerised TUI at /host (for uploads/downloads)
PG_HOST_DIR=.
