#!/usr/bin/env python3
"""Fake COLMAP for integration tests. FAKE_COLMAP_FLAVOR=new|refrac."""
import os, sys, struct, shutil
from pathlib import Path

flavor = os.environ.get("FAKE_COLMAP_FLAVOR", "new")
calls = os.environ.get("FAKE_CALLS")
if calls:
    with open(calls, "a") as f:
        f.write("colmap " + " ".join(sys.argv[1:]) + "\n")
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
args = sys.argv[2:]
def opt(name, default=None):
    return args[args.index(name) + 1] if name in args else default

COMMON = ["database_path", "image_path"]
HELP = {
  "new": {
    "feature_extractor": ["ImageReader.camera_model", "ImageReader.single_camera", "ImageReader.camera_params",
        "FeatureExtraction.use_gpu", "FeatureExtraction.max_image_size", "SiftExtraction.max_num_features",
        "SiftExtraction.domain_size_pooling", "SiftExtraction.estimate_affine_shape", "SiftExtraction.peak_threshold"],
    "matcher": ["FeatureMatching.use_gpu", "FeatureMatching.guided_matching", "SequentialMatching.overlap",
        "SequentialMatching.loop_detection"],
    "mapper": ["Mapper.ba_refine_extra_params"],
  },
  "refrac": {
    "feature_extractor": ["ImageReader.camera_model", "ImageReader.single_camera", "ImageReader.camera_params",
        "ImageReader.camera_refrac_model", "ImageReader.camera_refrac_params",
        "SiftExtraction.use_gpu", "SiftExtraction.max_image_size", "SiftExtraction.max_num_features",
        "SiftExtraction.domain_size_pooling", "SiftExtraction.estimate_affine_shape", "SiftExtraction.peak_threshold"],
    "matcher": ["SiftMatching.use_gpu", "SiftMatching.guided_matching", "TwoViewGeometry.enable_refraction",
        "SequentialMatching.overlap", "SequentialMatching.loop_detection"],
    "mapper": ["Mapper.enable_refraction", "Mapper.ba_refine_refrac_params"],
  },
}
if "-h" in args:
    key = "matcher" if cmd.endswith("_matcher") else cmd if cmd in ("feature_extractor", "mapper", "hierarchical_mapper") else None
    key = "mapper" if key == "hierarchical_mapper" else key
    print("Options:\n  -h [ --help ]")
    for o in COMMON + (HELP[flavor].get(key, []) if key else []):
        print(f"  --{o} arg")
    sys.exit(0)

IMG = {".jpg", ".jpeg", ".png"}
def imgs(d):
    return sorted(p for p in Path(d).iterdir() if p.suffix.lower() in IMG)

if cmd == "feature_extractor":
    if flavor == "new" and any(a.startswith("--ImageReader.camera_refrac") for a in args):
        print("unrecognised option"); sys.exit(1)
    n = len(imgs(opt("--image_path")))
    Path(opt("--database_path")).write_text("db")
    for i in range(n):
        print(f"Processed file [{i+1}/{n}]")
elif cmd.endswith("_matcher"):
    print("Matching block [1/1, 1/1]")
elif cmd in ("mapper", "hierarchical_mapper"):
    n = len(imgs(opt("--image_path")))
    out = Path(opt("--output_path")) / "0"
    out.mkdir(parents=True, exist_ok=True)
    (out / "images.bin").write_bytes(struct.pack("<Q", n))
    (out / "points3D.bin").write_bytes(struct.pack("<Q", 123))
    (out / "cameras.bin").write_bytes(struct.pack("<Q", 1))
    for i in range(n):
        print(f"Registering image #{i+1} ({i+1})")
elif cmd == "model_converter":
    inp, out, typ = Path(opt("--input_path")), Path(opt("--output_path")), opt("--output_type")
    if typ == "PLY":
        out.write_text("ply\n")
    else:
        out.mkdir(parents=True, exist_ok=True)
        tail = " FLATPORT 0 0 1 0.01 0.01 1 1.49 1.334" if flavor == "refrac" else ""
        (out / "cameras.txt").write_text("# Camera list\n1 PINHOLE 64 48 50 50 32 24" + tail + "\n")
        n = struct.unpack("<Q", (inp / "images.bin").read_bytes()[:8])[0] if (inp / "images.bin").exists() else 2
        (out / "images.txt").write_text("".join(f"{i+1} 1 0 0 0 0 0 0 1 img{i}.jpg\n\n" for i in range(n)))
        (out / "points3D.txt").write_text("1 0 0 0 255 255 255 0.1\n")
elif cmd == "image_undistorter":
    out = Path(opt("--output_path"))
    (out / "images").mkdir(parents=True, exist_ok=True)
    (out / "sparse").mkdir(parents=True, exist_ok=True)
    src = imgs(opt("--image_path"))
    for p in src:
        shutil.copy(p, out / "images" / p.name)
    for f in ("images.bin", "points3D.bin", "cameras.bin"):
        shutil.copy(Path(opt("--input_path")) / f, out / "sparse" / f)
    for i in range(len(src)):
        print(f"Undistorting image [{i+1}/{len(src)}]")
else:
    print(f"fake colmap: unknown command {cmd}"); sys.exit(2)
