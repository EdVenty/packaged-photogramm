#!/usr/bin/env python3
import os, sys
from pathlib import Path
tool = Path(sys.argv[0]).name
args = sys.argv[1:]
calls = os.environ.get("FAKE_CALLS")
if calls:
    with open(calls, "a") as f:
        f.write(tool + " " + " ".join(args) + "\n")
if "--help" in args:
    print(f"{tool} options:\n -i [ --input-file ] arg\n -o [ --output-file ] arg\n --pointcloud-file arg\n"
          " -m [ --mesh-file ] arg\n --export-type arg\n --max-resolution arg\n --number-views-fuse arg")
    sys.exit(0)
def opt(*names):
    for n in names:
        if n in args:
            return args[args.index(n) + 1]
out = Path(opt("-o", "--output-file"))
inp = Path(opt("-i", "--input-file"))
assert inp.exists(), f"missing input {inp}"
print("Processing (50%, 1s)")
out.write_text("mvs")
if tool == "TextureMesh" and opt("--export-type") == "obj":
    out.with_suffix(".obj").write_text("mtllib x.mtl\nv 0 0 0\n")
    out.with_suffix(".mtl").write_text("newmtl m\n")
    (out.parent / (out.stem + "_material_0_map_Kd.jpg")).write_bytes(b"jpg")
elif tool != "InterfaceCOLMAP":
    out.with_suffix(".ply").write_text("ply\n")
print("Processing (100%, 2s)")
